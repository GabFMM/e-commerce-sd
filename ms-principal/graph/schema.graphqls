enum Situacao {
  CRIADO
  ESTOQUE_DISPONIVEL
  ESTOQUE_INDISPONIVEL
  PAGAMENTO_APROVADO
  PAGAMENTO_RECUSADO
  ENVIADO
}

type Produto {
  id: Int!
  nome: String!
  categoria: String!
  quantidadeDisponivel: Int!
}

type Pedido {
  id: Int!
  situacao: Situacao!
  produtos: [ItemPedido!]!
}

type ItemPedido {
  produtoId: Int!
  quantidade: Int!
}

input ItemPedidoInput {
  produtoId: Int!
  quantidade: Int!
}

input CriarPedidoRequest {
  itens: [ItemPedidoInput!]!
}

type CriarPedidoResponse {
  id: Int!
  situacao: Situacao!
}

input RemoverPedidoRequest {
  id: Int!
}

type Query {
  produtos(
    ids: [Int!]
    nomeLike: String
  ): [Produto!]!

  pedidos: [Pedido!]!
}

type Mutation {
  criarPedido(request: CriarPedidoRequest!): CriarPedidoResponse!
  removerPedido(request: RemoverPedidoRequest!): Boolean!
}